  -> luxrail variables list
railway variables --kv
  -> luxrail variables list --kv
railway variables -k
  -> luxrail variables list --kv
railway variables --set KEY=value
  -> luxrail variables set KEY=value
railway variables --set A=1 --set B=2 --skip-deploys
  -> luxrail variables set A=1 B=2 --skip-deploys
railway variables --set=A=1
  -> luxrail variables set A=1
