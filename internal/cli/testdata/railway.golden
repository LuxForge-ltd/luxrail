  -> luxrail whoami
railway init
  -> luxrail init
railway init --name my-app
  -> luxrail init --name my-app
railway init -n my-app --workspace acme
  -> luxrail init -n my-app
railway link
  -> luxrail link
railway link --project my-app --environment staging --service web
  -> luxrail link --project my-app --environment staging --service web
railway link -p my-app -t team1
  -> luxrail link -p my-app
