{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "luxforge/tower/Dockerfile",
    "watchPatterns": ["luxforge/tower/**"]
  },
  "deploy": {
    "healthcheckPath": "/api/v1/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "singleton": true
  }
}
